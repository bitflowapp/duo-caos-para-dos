# Variables de entorno del servidor (todas opcionales). No hay secretos.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Detrás del proxy del hosting (Render/Koyeb/Fly): respetar X-Forwarded-*
TRUST_PROXY=1
# Carpeta del build del cliente (por defecto apps/web/dist)
# STATIC_DIR=/app/apps/web/dist
# Orígenes extra permitidos para Socket.IO si el cliente se aloja en otro dominio
# ALLOWED_ORIGINS=https://mi-dominio.example
MAX_ROOMS=500
MAX_CONNECTIONS_PER_IP=16
JOIN_ATTEMPTS_PER_MINUTE=20
